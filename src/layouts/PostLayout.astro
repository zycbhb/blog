---
import type { Post } from "../utils/posts";
import { formatDate, postUrl } from "../utils/posts";

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props;
---

<main class="article-wrap">
  <a class="back" href="/">← 返回日志</a>

  <article class="article">
    <p class="kicker">// {post.data.tags.join(" / ")}</p>
    <h1>{post.data.title}</h1>
    <p class="article-meta">
      <span>{formatDate(post.data.pubDate)}</span>
      <span>{post.data.minutes} MIN READ</span>
      {post.data.tags.map((tag) => <span>#{tag}</span>)}
    </p>

    <p class="summary">{post.data.summary ?? post.data.description}</p>

    <slot />
  </article>

  <nav class="post-nav">
    {prev ? (
      <a href={postUrl(prev)}><span>← PREV</span>{prev.data.title}</a>
    ) : (
      <a href="/archive.html"><span>← ARCHIVE</span>全部记录</a>
    )}
    {next ? (
      <a href={postUrl(next)}><span>NEXT →</span>{next.data.title}</a>
    ) : (
      <a href="/archive.html"><span>ARCHIVE →</span>全部记录</a>
    )}
  </nav>
</main>
