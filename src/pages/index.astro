---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import { getPosts, tagCounts, tagId } from "../utils/posts";

const posts = await getPosts();
const tags = tagCounts(posts).slice(0, 10);
---

<BaseLayout
  title="监视者日志 · OVERSEER.LOG"
  description="记录两台小服务器、一条隧道和无数次重启。一个关于 Homelab、网络、容器与自托管的个人技术博客。"
  active="home"
  status="LINK STABLE"
>
  <main class="wrap">
    <section class="hero">
      <div class="hero-copy"><h1>监视者日志<span>。</span></h1>
        <p class="lead">两台小服务器，一本折腾手记。记下家里的网络怎么连，也记下那台旧笔记本怎样又派上了用场。</p>
        <a class="reading" href="#archive">往下读 ↓</a>
        <button type="button" class="scenery-switch">换风景 ↻</button>
        <small class="scenery-status" role="status"></small>
      </div>
      <figure class="window"><img src="/assets/window.webp" alt="阳光照进书房，寻页在窗边的小服务器旁写笔记" />
        <figcaption><span>寻页的窗边书桌</span><button data-visit>和她聊聊 ↗</button></figcaption>
      </figure>
    </section>
    <div class="layout">
      <section id="archive" class="feed">
        <div class="section-head">
          <h2>最近的记录</h2>
          <span>按日期排列</span>
        </div>
        <ol class="posts">
          {posts.map((post, index) => <PostRow post={post} index={index} />)}
        </ol>
        <a class="more" href="/archive.html">浏览全部文章 →</a>
      </section>

      <aside class="side">
        <section id="tags" class="panel">
          <h4>按主题翻阅</h4>
          <div class="tagcloud">
            {tags.map((tag) => (
              <a href={`/tags.html#${tagId(tag.name)}`}>{tag.name}</a>
            ))}
          </div>
        </section>

        <section id="about" class="panel about">
          <h4>关于这里</h4>
          <p>一个放在 Alpine 小机器上的 Homelab 记录站。关于网络、容器、监控，以及把旧硬件用到极限的执念。</p>
          <p class="sign">— 守望者 / 2026 · <a href="/about.html">更多</a></p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

