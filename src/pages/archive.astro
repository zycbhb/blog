---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import { getPosts, formatDate } from "../utils/posts";

const posts = await getPosts();
const lastSync = posts[0] ? formatDate(posts[0].data.pubDate) : "2026.10.28";
---

<BaseLayout
  title="归档 · 监视者日志"
  description="监视者日志的全部文章归档。"
  active="archive"
  status="ARCHIVE OPEN"
>
  <main class="page-wrap">
    <section class="page-head">
      <p class="kicker">// ALL RECORDS / 2026</p>
      <h1>归档</h1>
      <p class="lead">按时间倒序排列的全部记录。关于网络、容器、监控，以及那些凌晨三点还在滚动的日志。</p>
      <div class="meta">
        <span>{String(posts.length).padStart(2, "0")} 篇文章</span>
        <span>最后更新 {lastSync}</span>
        <span>NEWEST FIRST</span>
      </div>
    </section>

    <div class="page-body">
      <div class="section-head">
        <h2>2026</h2>
        <span>{String(posts.length).padStart(2, "0")} RECORDS</span>
      </div>
      <ol class="posts">
        {posts.map((post, index) => <PostRow post={post} index={index} />)}
      </ol>
      <a class="more" href="/tags.html">[ 按标签浏览 ]</a>
    </div>
  </main>
</BaseLayout>
